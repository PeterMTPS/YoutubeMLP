{
  "manifest_version": 3,
  "name": "PonyTube Pastel Theme",
  "description": "Transforma o YouTube em um tema pastel inspirado em My Little Pony.",
  "version": "2.0.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/background.webp"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "PonyTube",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "palette.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
